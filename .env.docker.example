# ============================================================
# HR Platform — Docker uchun .env namunasi
# Buni ".env" deb nomlab, loyiha ILDIZIGA (Dockerfile bilan bir
# joyga) qo'ying va HAQIQIY qiymatlar bilan to'ldiring.
# ============================================================

# --- Django asosiy ---
SECRET_KEY=BUNI_ALMASHTIRING_kamida_50_ta_tasodifiy_belgi
DEBUG=False
ALLOWED_HOSTS=REAL_DOMAIN,www.REAL_DOMAIN
ENABLE_SSL_REDIRECT=False



# --- Telegram botlar ---
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_BOT_TOKEN_2=
BOT_USERNAME_2=

# --- AI (Groq) ---
GROQ_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=HR Project <noreply@sizning-domeningiz.uz>
# Quyidagilar hozircha kod ichida ishlatilmasa ham, settings.py talab qiladi:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

PLATFORM_URL=https://REAL_DOMAIN

# --- PostgreSQL ---
# MUHIM: docker-compose.yml ichida "db" xizmati ham AYNAN shu
# DB_NAME/DB_USER/DB_PASSWORD qiymatlaridan foydalanadi — ular
# ikkala joyda (web va db) bir xil bo'lishi shart.
USE_POSTGRES=True
DB_NAME=hr_db
DB_USER=hr_user
DB_PASSWORD=BUNI_ALMASHTIRING_kuchli_parol

# DB_HOST va DB_PORT docker-compose.yml da "web"/bot xizmatlari uchun
# avtomatik "db"/5432 ga o'rnatiladi — bu yerda qoldirib ketishingiz mumkin,
# lekin agar shu faylni lokal (Docker'siz) test qilsangiz kerak bo'ladi:
DB_HOST=db
DB_PORT=5432

# --- Redis (Channels layer) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORS (frontend domeningiz) ---
CORS_ALLOWED_ORIGINS=https://sizning-frontend-domeningiz.uz
